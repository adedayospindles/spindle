{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "brand",
          "color": "#2556a8",
          "name": "Brand"
        },
        {
          "slug": "ink",
          "color": "#162337",
          "name": "Ink"
        },
        {
          "slug": "muted",
          "color": "#526276",
          "name": "Muted"
        },
        {
          "slug": "surface",
          "color": "#f6f8fc",
          "name": "Surface"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        },
        {
          "slug": "gold",
          "color": "#ec9e29",
          "name": "Gold"
        }
      ],
      "defaultPalette": false
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "fontFamily": "-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif",
          "name": "System Sans"
        },
        {
          "slug": "serif",
          "fontFamily": "Georgia,Times New Roman,serif",
          "name": "Editorial Serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "normal",
          "size": "1rem",
          "name": "Normal"
        },
        {
          "slug": "medium",
          "size": "1.25rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "clamp(1.5rem,3vw,2.25rem)",
          "name": "Large"
        },
        {
          "slug": "display",
          "size": "clamp(2.5rem,6vw,4.5rem)",
          "name": "Display"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "size": "0.5rem",
          "name": "XS"
        },
        {
          "slug": "30",
          "size": "1rem",
          "name": "S"
        },
        {
          "slug": "40",
          "size": "1.5rem",
          "name": "M"
        },
        {
          "slug": "50",
          "size": "2.5rem",
          "name": "L"
        },
        {
          "slug": "60",
          "size": "4rem",
          "name": "XL"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "text": "#162337",
      "background": "#ffffff"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#2556a8"
        }
      },
      "heading": {
        "typography": {
          "lineHeight": "1.2"
        }
      }
    }
  }
}
